{
  "name": "qa-automation-interview-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:selenium": "tsx selenium/smoke.ts",
    "db:migrate": "node scripts/flyway.mjs migrate",
    "db:info": "node scripts/flyway.mjs info",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "flyway": "^0.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "selenium-webdriver": "^4.28.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "@types/node@26.6.6": true
  }
}
